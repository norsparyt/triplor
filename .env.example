# Copy to .env (git-ignored) and change the values. Local development only.
POSTGRES_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
ADVENTURE_DB_PASSWORD=change-me
MONGO_ROOT_PASSWORD=change-me

# Optional: the first admin account for the identity service, created at start-up if absent.
TRIPLOR_ADMIN_EMAIL=admin@triplor.local
TRIPLOR_ADMIN_PASSWORD=admin_local_pass_123

# Optional: password of the load-test users created by the `seed` Spring profile.
TRIPLOR_SEED_PASSWORD=admin-seed_pass_123
