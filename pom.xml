<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.triplor</groupId>
  <artifactId>triplor-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>triplor</name>
  <description>Triplor backend: Spring Boot services for a travel-matching app</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Not managed by Spring Boot. The 3.x line is the one for Boot 4. -->
    <springdoc.version>3.2.0</springdoc.version>
  </properties>

  <modules>
    <module>libs/common</module>
    <module>libs/test-support</module>
    <module>services/identity</module>
    <module>services/adventure</module>
    <module>services/chat</module>
  </modules>

  <!-- Versions of our own modules, so services can depend on them without repeating the version. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.triplor</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.triplor</groupId>
        <artifactId>test-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
