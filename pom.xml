<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.triplor</groupId>
  <artifactId>triplor-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>triplor</name>
  <description>Triplor backend: Spring Boot services for a travel-matching app</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Not managed by Spring Boot. The 3.x line is the one for Boot 4. -->
    <springdoc.version>3.2.0</springdoc.version>
    <jacoco.version>0.8.16</jacoco.version>
    <!-- The lowest line coverage the build accepts. Each service sets its own figure. -->
    <jacoco.line.minimum>0.00</jacoco.line.minimum>
  </properties>

  <modules>
    <module>libs/common</module>
    <module>libs/test-support</module>
    <module>services/identity</module>
    <module>services/adventure</module>
    <module>services/chat</module>
  </modules>

  <!-- Versions of our own modules, so services can depend on them without repeating the version. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.triplor</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.triplor</groupId>
        <artifactId>test-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <!--
        Measures which lines the tests execute. `prepare-agent` attaches the recorder to the
        test JVM, `report` writes target/site/jacoco, and `check` fails the build if line
        coverage of the module drops below jacoco.line.minimum.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
